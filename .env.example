# Copy to .env and fill in real values. .env is git-ignored — never commit it.
DATABASE_URL=postgresql://app:CHANGE_ME@localhost:5432/assistant
GMAIL_ACCOUNT_REF=personal
GMAIL_OAUTH_TOKEN_PATH=/path/outside/repo/gmail_token.json
POLL_INTERVAL_SECONDS=60
POISON_THRESHOLD=5
LOG_LEVEL=INFO
PAYLOAD_STORE_DIR=var/payloads
